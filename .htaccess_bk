RewriteEngine on
RewriteCond %{HTTP_HOST} ^cotuong.vietnamcleveland.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www.cotuong.vietnamcleveland.com$
RewriteCond %{REQUEST_URI} !public/
RewriteRule (.*) /public/$1 [L]
<IfModule LiteSpeed>
    SpdyEnabled http2 http3
    CacheLookup on
    QuicEnable on
</IfModule>