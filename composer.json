{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3.0",
        "asika/autolink": "^2.0",
        "atrox/haikunator": "^1.3",
        "creativeorange/gravatar": "~1.0",
        "elorating/elorating": "master",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.2",
        "jaydeep/laravel-time-machine": "^1.1",
        "laravel-lang/lang": "^14.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.3",
        "laravel/passport": "^13.7",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.12",
        "laravel/tinker": "*",
        "laravel/ui": "*",
        "laravolt/avatar": "^7.0",
        "litespeed/lscache-laravel": "^1.3",
        "munafio/chatify": "^1.6",
        "payos/payos": "*",
        "phpmailer/phpmailer": "^6.5",
        "pusher/pusher-php-server": "^7.2",
        "renatomarinho/laravel-page-speed": "^4.0",
        "riverskies/laravel-mobile-detect": "^1.3",
        "simplesoftwareio/simple-qrcode": "~4",
        "socialiteproviders/zalo": "^5.0",
        "spatie/laravel-cookie-consent": "^3.1",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/schema-org": "^3.14",
        "tttran/viet_qr_generator": "^0.7.0",
        "vedmant/laravel-feed-reader": "^1.5",
        "vrkansagara/lara-out-press": "^2.1",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/functions.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
